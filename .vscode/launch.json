{
  // Debugger untuk halaman HTML statis (P02 & P03) dan dashboard Modul 4.
  // Jalankan server lokal dulu, contoh: cd P04 && npm start
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Buka Modul 3 (index.html)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/P03/index.html",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Buka Modul 4 (dashboard)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8080/P04/index.html",
      "webRoot": "${workspaceFolder}/P04"
    },
    {
      "name": "Lampirkan ke Browser Terintegrasi",
      "type": "editor-browser",
      "request": "attach",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
